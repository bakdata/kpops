{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": true,
  "json": {},
  "yaml": {},
  "markdown": {},
  "toml": {},
  "malva": {},
  "includes": ["**/*.{json,jsonc,yaml,yml,md,toml,css}"],
  "excludes": [
    ".pytest_cache/**",
    ".mypy_cache/**",
    "**/.venv/**",
    "**/cli-commands.md",
    "**/cli_env_vars.md",
    "**/config_env_vars.md",
    "tests/compiler/resources/erroneous-file.yaml",
    "tests/**/snapshots/**",
    "docs/docs/resources/**",
    "docs/docs/schema/**",
    "docs/docs/user/changelog.md",
  ],
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.9.0",
    "npm:dprint-plugin-malva@0.16.0",
  ],
}
